MODEL_PROVIDER=bltcy
BLTCY_API_KEY=
BLTCY_CHAT_COMPLETIONS_URL=https://api.bltcy.ai/v1/chat/completions
BLTCY_AUDIO_TRANSCRIPTIONS_URL=https://api.bltcy.ai/v1/audio/transcriptions
MOCK_ANALYSIS=true
MODEL_TIMEOUT_SECONDS=180

MODEL_VIDEO_UNDERSTANDING=gemini-3.1-flash-lite-preview-thinking-minimal
MODEL_COPY_ANALYSIS=gpt-5.4-nano
MODEL_STRUCTURE_ANALYSIS=gpt-5.4-nano
MODEL_IMAGE_ANALYSIS=gpt-5.4-nano
MODEL_SUBTITLE_AUDIO_ANALYSIS=gpt-5.4-nano
MODEL_SUMMARY_GENERATION=gpt-5.4-nano
MODEL_TEMPLATE_GENERATION=gpt-5.4-nano
MODEL_TRANSCRIPTION=gpt-5.4-nano

# Optional image asset generation for web-video-console.
# Prefer setting these in config.local.json for local runs.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGES_GENERATIONS_URL=https://api.openai.com/v1/images/generations
IMAGE_ASSET_MODEL=gpt-image-2
