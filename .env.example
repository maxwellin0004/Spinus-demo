DATABASE_URL="postgresql://USER@localhost:5432/tanglin_rd?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
PAYMENT_CONFIG_SECRET="replace-with-another-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PASSWORD_RESET_DEV_LINKS="false"
EMAIL_VERIFICATION_DEV_LINKS="false"
# Optional webhook for external notifications. The app still writes in-app
# notifications when this is empty.
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_SECRET=""
# Optional. When missing, the app uses the mock AI provider.
OPENAI_API_KEY=""
INSIGHT_AI_BASE_URL="https://4router.net/v1"
INSIGHT_AI_API_KEY=""
INSIGHT_AI_MODEL="gpt-5.5"
INSIGHT_IMAGE_AI_BASE_URL="https://4router.net/v1"
INSIGHT_IMAGE_AI_API_KEY=""
INSIGHT_IMAGE_AI_MODEL="gpt-image-2"
HTTP_PROXY=""
HTTPS_PROXY=""
# Optional distributed cache. When empty, insights cache falls back to in-memory.
INSIGHTS_REDIS_URL=""
INSIGHTS_REDIS_PREFIX="insights-cache:v1"

# TikHub data API. Used by the insights MVP collector.
TIKHUB_API_KEY=""
TIKHUB_BASE_URL="https://api.tikhub.io"
INSIGHTS_INTERNAL_TOKEN="replace-with-a-long-random-token"

# Crawler worker integration. Use the same token in ../tanglin-crawler/.env.
CRAWLER_INTERNAL_TOKEN="replace-with-a-long-random-token"
CRAWLER_WORKER_HEALTH_URL="http://127.0.0.1:8787/health"

# Alipay page-pay integration. Use sandbox values first, then production values
# after the Alipay application is approved.
ALIPAY_APP_ID=""
ALIPAY_APP_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY_URL="https://openapi-sandbox.dl.alipaydev.com/gateway.do"
ALIPAY_NOTIFY_URL="https://your-domain.example/api/payments/alipay/notify"
ALIPAY_RETURN_URL="https://your-domain.example/brand/billing?tab=invoices"

# WeChat Pay V3 Native QR payment. These can also be configured in Admin Settings.
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MERCHANT_ID=""
WECHAT_PAY_CERT_SERIAL_NO=""
WECHAT_PAY_MERCHANT_PRIVATE_KEY=""
WECHAT_PAY_PLATFORM_PUBLIC_KEY=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_GATEWAY_URL="https://api.mch.weixin.qq.com"
WECHAT_PAY_NOTIFY_URL="https://your-domain.example/api/payments/wechat/notify"

# File uploads. Default is local public/uploads for development.
# Use s3 for Cloudflare R2 or any S3-compatible storage in production.
UPLOAD_MAX_BYTES="52428800"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
