{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module_registry.schema.json",
  "title": "Module Registry",
  "type": "object",
  "required": ["schemaVersion", "artifact", "modules"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "artifact": {
      "type": "object",
      "required": ["type", "status", "createdAt", "updatedAt", "generator"],
      "properties": {
        "type": {"const": "module_registry"},
        "status": {"enum": ["draft", "partial", "ready", "stale", "failed"]},
        "createdAt": {"type": "string"},
        "updatedAt": {"type": "string"},
        "generator": {"type": "string"}
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "moduleId",
          "templateId",
          "displayName",
          "sceneRole",
          "supportedAspectRatios",
          "contentDomains",
          "layoutTags",
          "retentionTags",
          "styleTags",
          "inputFields",
          "assetSlots",
          "riskLevel",
          "notes"
        ],
        "properties": {
          "moduleId": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
          "templateId": {"type": "string"},
          "displayName": {"type": "string"},
          "sceneRole": {"type": "string"},
          "supportedAspectRatios": {"type": "array", "items": {"type": "string"}},
          "contentDomains": {"type": "array", "items": {"type": "string"}},
          "layoutTags": {"type": "array", "items": {"type": "string"}},
          "retentionTags": {"type": "array", "items": {"type": "string"}},
          "styleTags": {"type": "array", "items": {"type": "string"}},
          "inputFields": {"type": "array", "items": {"type": "string"}},
          "assetSlots": {"type": "array", "items": {"type": ["string", "object"]}},
          "riskLevel": {"enum": ["low", "medium", "high"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
