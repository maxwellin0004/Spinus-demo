generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BRAND
  CREATOR
}

enum AdminLevel {
  FOUNDER
  STAFF
}

enum AdminDataScope {
  ALL
  ASSIGNED
  TEAM
}

enum UserStatus {
  ACTIVE
  PENDING
  FROZEN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CreatorLevel {
  NEW
  VERIFIED
  PRO
  ELITE
}

enum CampaignStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_REVIEW
  REJECTED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

enum DraftStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  BLOCKED
}

enum DraftReviewStatus {
  NOT_REQUIRED
  NOT_SUBMITTED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  DRAFT_CREATED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  PROOF_SUBMITTED
  VERIFIED
  SETTLED
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_SUPPLEMENT
}

enum PublicationStatus {
  PENDING_PUBLICATION
  LINK_SUBMITTED
  ACCEPTED
  REJECTED
  RESUBMITTED
  DISPUTED
  EXPIRED
}

enum SettlementStatus {
  NOT_ESCROWED
  ESCROWED
  PAYABLE
  PAID_TO_WALLET
  REFUNDED
  PARTIALLY_SETTLED
  CANCELLED
}

enum WalletTxType {
  EARNING
  WITHDRAWAL
  ADJUSTMENT
  FREEZE
  UNFREEZE
}

enum BrandLedgerTxType {
  PAYMENT
  ESCROW_FREEZE
  ESCROW_RELEASE
  KOL_SETTLEMENT
  REFUND
  ADJUSTMENT
  PLATFORM_FEE
}

enum BrandLedgerTxStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum WalletTxStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BrandRefundStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum ComplianceRuleType {
  SENSITIVE_WORD
  PROHIBITED_EXPRESSION
  DISCLOSURE
  PLATFORM_RULE
}

enum BrandRequestStatus {
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  CONVERTED
  CLOSED
}

enum SocialVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeStatus {
  OPEN
  NEEDS_INFO
  DECIDED
  CLOSED
}

enum DisputeDecision {
  FULL_SETTLEMENT
  FULL_REFUND
  PARTIAL_SETTLEMENT
  ALLOW_RESUBMISSION
}

enum CrawlerPlatform {
  XIAOHONGSHU
  DOUYIN
}

enum CrawlerJobType {
  FETCH_SOCIAL_ACCOUNT
  FETCH_POST_METRICS
  REFRESH_SOCIAL_ACCOUNT
  REFRESH_POST_METRICS
}

enum CrawlerTargetType {
  SOCIAL_ACCOUNT
  PROOF
}

enum CrawlerJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum CrawlerSnapshotStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AuthorMatchStatus {
  MATCHED
  MISMATCHED
  UNKNOWN
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String
  role                   UserRole
  status                 UserStatus             @default(ACTIVE)
  adminProfile           AdminProfile?
  brandProfile           BrandProfile?
  creatorProfile         CreatorProfile?
  creatorReferral        CreatorReferralAttribution?
  invitationCodesCreated InvitationCode[]       @relation("InvitationCodeCreator")
  invitationAttribution  InvitationAttribution?
  submissionReviews      SubmissionReview[]     @relation("Reviewer")
  brandMessages          BrandMessage[]         @relation("BrandMessageAuthor")
  notifications          Notification[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model AdminProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  level                  AdminLevel              @default(STAFF)
  permissions            String[]                @default([])
  dataScope              AdminDataScope          @default(ASSIGNED)
  teamName               String?
  wechat                 String?
  createdById            String?
  managedBrands          BrandProfile[]          @relation("BrandResponsible")
  managedCreators        CreatorProfile[]        @relation("CreatorResponsible")
  brandRequests          BrandRequest[]          @relation("BrandRequestResponsible")
  invitationCodes        InvitationCode[]
  invitationAttributions InvitationAttribution[] @relation("InvitationAttributionAdmin")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model InvitationCode {
  id             String                  @id @default(cuid())
  code           String                  @unique
  adminProfileId String
  adminProfile   AdminProfile            @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  active         Boolean                 @default(true)
  note           String?
  createdById    String?
  createdBy      User?                   @relation("InvitationCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attributions   InvitationAttribution[]
  deactivatedAt  DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([adminProfileId, active])
}

model InvitationAttribution {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationCodeId String
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  codeSnapshot     String
  invitedByAdminId String
  invitedByAdmin   AdminProfile   @relation("InvitationAttributionAdmin", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([invitedByAdminId, createdAt])
  @@index([codeSnapshot])
}

model BrandProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName           String
  companyName         String
  contactName         String
  email               String
  telegram            String?
  whatsapp            String?
  website             String?
  industry            String
  insightDirection    String                   @default("beauty")
  country             String
  logoUrl             String?
  description         String
  reviewStatus        ReviewStatus             @default(PENDING)
  riskLevel           RiskLevel                @default(LOW)
  internalNote        String?
  responsibleAdminId  String?
  responsibleAdmin    AdminProfile?            @relation("BrandResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  isDemo              Boolean                  @default(false)
  budgetBalance       Decimal                  @default(0) @db.Decimal(12, 2)
  frozenEscrowBalance Decimal                  @default(0) @db.Decimal(12, 2)
  campaigns           Campaign[]
  requests            BrandRequest[]
  messages            BrandMessage[]
  invoices            Invoice[]
  ledgerTransactions  BrandLedgerTransaction[]
  refundRequests      BrandRefundRequest[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model BrandRequest {
  id                  String             @id @default(cuid())
  brandId             String
  brand               BrandProfile       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  responsibleAdminId  String?
  responsibleAdmin    AdminProfile?      @relation("BrandRequestResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  title               String
  objective           String
  description         String
  budget              Decimal?           @db.Decimal(12, 2)
  expectedLaunchDate  DateTime?
  status              BrandRequestStatus @default(SUBMITTED)
  convertedCampaignId String?
  messages            BrandMessage[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model CreatorProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  fullName           String?
  email              String
  shareCode          String              @unique
  country            String
  languages          String[]            @default([])
  categories         String[]            @default([])
  contentTypes       String[]            @default([])
  insightDirection   String              @default("beauty")
  bio                String?
  avatarUrl          String?
  level              CreatorLevel        @default(NEW)
  reviewStatus       ReviewStatus        @default(PENDING)
  riskLevel          RiskLevel           @default(LOW)
  riskScore          Int                 @default(0)
  violationCount     Int                 @default(0)
  completionRate     Decimal             @default(0) @db.Decimal(6, 2)
  cumulativeIncome   Decimal             @default(0) @db.Decimal(12, 2)
  completedTasks     Int                 @default(0)
  responsibleAdminId String?
  responsibleAdmin   AdminProfile?       @relation("CreatorResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  isDemo             Boolean             @default(false)
  socialAccounts     SocialAccount[]
  applications       TaskApplication[]
  drafts             ContentDraft[]
  submissions        Submission[]
  proofs             Proof[]
  wallet             Wallet?
  withdrawalRequests WithdrawalRequest[]
  walletTransactions WalletTransaction[]
  referralsReceived  CreatorReferralAttribution[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model CreatorReferralAttribution {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile  CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Restrict)
  codeSnapshot    String
  createdAt       DateTime       @default(now())

  @@index([creatorProfileId, createdAt])
  @@index([codeSnapshot])
}

model SocialAccount {
  id                   String                   @id @default(cuid())
  creatorId            String
  creator              CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform             String
  accountName          String
  accountUrl           String
  followers            Int                      @default(0)
  avgViews             Int                      @default(0)
  submittedFollowers   Int                      @default(0)
  submittedAvgViews    Int                      @default(0)
  contentType          String
  country              String
  language             String
  verified             Boolean                  @default(false)
  verificationStatus   SocialVerificationStatus @default(PENDING)
  verificationNote     String?
  verifiedAt           DateTime?
  note                 String?
  selectedApplications TaskApplication[]
  crawlerJobs          CrawlerJob[]
  metricSnapshots      SocialAccountSnapshot[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model Campaign {
  id                            String                   @id @default(cuid())
  brandId                       String
  brand                         BrandProfile             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title                         String
  productName                   String?
  landingUrl                    String?
  industry                      String
  description                   String
  objective                     String
  targetPlatforms               String[]                 @default([])
  targetCountries               String[]                 @default([])
  targetLanguages               String[]                 @default([])
  targetAudience                String?
  startDate                     DateTime
  endDate                       DateTime
  totalBudget                   Decimal                  @db.Decimal(12, 2)
  creatorBudget                 Decimal                  @db.Decimal(12, 2)
  platformFee                   Decimal                  @db.Decimal(12, 2)
  currency                      String                   @default("CNY")
  escrowAmount                  Decimal                  @default(0) @db.Decimal(12, 2)
  escrowFrozenAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  escrowReleasedAmount          Decimal                  @default(0) @db.Decimal(12, 2)
  platformFeeRate               Decimal                  @default(0) @db.Decimal(6, 4)
  baseReward                    Decimal                  @db.Decimal(12, 2)
  bonusRules                    Json?
  brief                         String
  mustInclude                   String[]                 @default([])
  mustNotInclude                String[]                 @default([])
  visualRequirements            String[]                 @default([])
  hashtags                      String[]                 @default([])
  cta                           String
  disclosureRequired            Boolean                  @default(true)
  requiresDraftReview           Boolean                  @default(true)
  revisionLimit                 Int                      @default(2)
  acceptanceSlaDays             Int                      @default(3)
  highValueReviewThreshold      Decimal                  @default(50) @db.Decimal(12, 2)
  resubmissionGraceDays         Int                      @default(2)
  status                        CampaignStatus           @default(DRAFT)
  reviewNote                    String?
  slotsTotal                    Int                      @default(10)
  maxPerCreator                 Int                      @default(1)
  allowUnverifiedSocialAccounts Boolean                  @default(false)
  allowMultiPlatformProof       Boolean                  @default(false)
  riskLevel                     RiskLevel                @default(LOW)
  isDemo                        Boolean                  @default(false)
  assets                        CampaignAsset[]
  tasks                         CampaignTask[]
  drafts                        ContentDraft[]
  submissions                   Submission[]
  proofs                        Proof[]
  metricsSnapshots              MetricsSnapshot[]
  messages                      BrandMessage[]
  invoices                      Invoice[]
  ledgerTransactions            BrandLedgerTransaction[]
  refundRequests                BrandRefundRequest[]
  disputes                      Dispute[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
}

model CampaignAsset {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  url        String
  createdAt  DateTime @default(now())
}

model CampaignTask {
  id                   String            @id @default(cuid())
  campaignId           String
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title                String
  platform             String
  contentType          String
  platformRequirement  String?
  minimumFollowers     Int               @default(0)
  rewardAmount         Decimal           @db.Decimal(12, 2)
  slotsTotal           Int
  slotsTaken           Int               @default(0)
  creatorLevelRequired CreatorLevel      @default(NEW)
  deadline             DateTime
  draftDeadline        DateTime?
  publishDeadline      DateTime?
  status               TaskStatus        @default(ACTIVE)
  applications         TaskApplication[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model TaskApplication {
  id                          String            @id @default(cuid())
  taskId                      String
  task                        CampaignTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creatorId                   String
  creator                     CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status                      ApplicationStatus @default(APPLIED)
  applicationNote             String?
  selectedSocialAccountId     String?
  selectedSocialAccount       SocialAccount?    @relation(fields: [selectedSocialAccountId], references: [id], onDelete: SetNull)
  acceptedRequirementSnapshot Json?
  approvedAt                  DateTime?
  drafts                      ContentDraft[]
  submissions                 Submission[]
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@unique([taskId, creatorId])
}

model ContentDraft {
  id                   String            @id @default(cuid())
  applicationId        String
  application          TaskApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creatorId            String
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId           String
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform             String
  title                String
  script               String
  caption              String
  hashtags             String[]          @default([])
  coverText            String
  disclosurePosition   String?
  previewAttachmentUrl String?
  revisionRound        Int               @default(0)
  revisionReason       String?
  aiGeneratedRaw       Json?
  creatorEditedText    String?
  riskCheckResult      Json?
  status               DraftStatus       @default(DRAFT)
  reviewStatus         DraftReviewStatus @default(NOT_SUBMITTED)
  submissions          Submission[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Submission {
  id                 String              @id @default(cuid())
  applicationId      String
  application        TaskApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  draftId            String
  draft              ContentDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status             SubmissionStatus    @default(SUBMITTED)
  publicationStatus  PublicationStatus   @default(PENDING_PUBLICATION)
  settlementStatus   SettlementStatus    @default(ESCROWED)
  settlementAmount   Decimal?            @db.Decimal(12, 2)
  acceptedAt         DateTime?
  disputedAt         DateTime?
  submittedAt        DateTime            @default(now())
  approvedAt         DateTime?
  rejectedAt         DateTime?
  revisionNote       String?
  reviews            SubmissionReview[]
  proofs             Proof[]
  walletTransactions WalletTransaction[]
  disputes           Dispute[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SubmissionReview {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User           @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerRole UserRole
  decision     ReviewDecision
  comment      String
  riskPoints   String[]       @default([])
  createdAt    DateTime       @default(now())
}

model Proof {
  id                  String               @id @default(cuid())
  submissionId        String
  submission          Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  creatorId           String
  creator             CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId          String
  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform            String
  postUrl             String
  resolvedPostUrl     String?
  normalizedPostUrl   String
  urlCheckResult      Json?
  screenshotUrl       String?
  publishedAt         DateTime
  views               Int                  @default(0)
  likes               Int                  @default(0)
  comments            Int                  @default(0)
  shares              Int                  @default(0)
  saves               Int                  @default(0)
  clicks              Int                  @default(0)
  conversions         Int                  @default(0)
  verificationStatus  ProofStatus          @default(PENDING)
  publicationStatus   PublicationStatus    @default(LINK_SUBMITTED)
  rejectionReason     String?
  rejectionNote       String?
  resubmissionCount   Int                  @default(0)
  adminNote           String?
  metricsSnapshots    MetricsSnapshot[]
  crawlerJobs         CrawlerJob[]
  postMetricSnapshots PostMetricSnapshot[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([platform, normalizedPostUrl])
}

model MetricsSnapshot {
  id          String   @id @default(cuid())
  proofId     String
  proof       Proof    @relation(fields: [proofId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  saves       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  snapshotAt  DateTime @default(now())
}

model CrawlerJob {
  id               String                  @id @default(cuid())
  type             CrawlerJobType
  platform         CrawlerPlatform
  status           CrawlerJobStatus        @default(PENDING)
  targetType       CrawlerTargetType
  targetId         String
  targetUrl        String
  socialAccountId  String?
  socialAccount    SocialAccount?          @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  proofId          String?
  proof            Proof?                  @relation(fields: [proofId], references: [id], onDelete: Cascade)
  attempts         Int                     @default(0)
  maxAttempts      Int                     @default(2)
  lockedAt         DateTime?
  lockedBy         String?
  lastAttemptAt    DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdByUserId  String?
  socialSnapshots  SocialAccountSnapshot[]
  postSnapshots    PostMetricSnapshot[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  completedAt      DateTime?

  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([targetType, targetId])
  @@index([socialAccountId])
  @@index([proofId])
}

model SocialAccountSnapshot {
  id              String                @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  crawlerJobId    String?
  crawlerJob      CrawlerJob?           @relation(fields: [crawlerJobId], references: [id], onDelete: SetNull)
  platform        CrawlerPlatform
  status          CrawlerSnapshotStatus @default(PENDING)
  failureReason   String?
  displayName     String?
  profileUrl      String?
  platformUserId  String?
  followerCount   Int?
  followingCount  Int?
  likeCount       Int?
  postCount       Int?
  fetchedAt       DateTime
  rawProvider     String?
  rawUserId       String?
  rawCanonicalUrl String?
  rawMetricText   String?
  parserVersion   String?
  createdAt       DateTime              @default(now())

  @@index([socialAccountId, fetchedAt])
  @@index([crawlerJobId])
  @@index([platform, status])
}

model PostMetricSnapshot {
  id                   String                @id @default(cuid())
  proofId              String
  proof                Proof                 @relation(fields: [proofId], references: [id], onDelete: Cascade)
  crawlerJobId         String?
  crawlerJob           CrawlerJob?           @relation(fields: [crawlerJobId], references: [id], onDelete: SetNull)
  platform             CrawlerPlatform
  status               CrawlerSnapshotStatus @default(PENDING)
  failureReason        String?
  viewCount            Int?
  likeCount            Int?
  favoriteCount        Int?
  commentCount         Int?
  shareCount           Int?
  title                String?
  authorName           String?
  authorPlatformUserId String?
  publishedAt          DateTime?
  canonicalUrl         String?
  platformPostId       String?
  authorMatchStatus    AuthorMatchStatus     @default(UNKNOWN)
  fetchedAt            DateTime
  rawProvider          String?
  rawItemId            String?
  rawUserId            String?
  rawCanonicalUrl      String?
  rawMetricText        String?
  parserVersion        String?
  createdAt            DateTime              @default(now())

  @@index([proofId, fetchedAt])
  @@index([crawlerJobId])
  @@index([platform, status])
  @@index([authorMatchStatus])
}

model Wallet {
  id                  String              @id @default(cuid())
  creatorId           String              @unique
  creator             CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  availableBalance    Decimal             @default(0) @db.Decimal(12, 2)
  frozenBalance       Decimal             @default(0) @db.Decimal(12, 2)
  cumulativeIncome    Decimal             @default(0) @db.Decimal(12, 2)
  cumulativeWithdrawn Decimal             @default(0) @db.Decimal(12, 2)
  currency            String              @default("CNY")
  payoutWalletAddress String?
  bankInfo            Json?
  settlementStatus    String              @default("ACTIVE")
  transactions        WalletTransaction[]
  withdrawalRequests  WithdrawalRequest[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WalletTransaction {
  id                  String             @id @default(cuid())
  walletId            String
  wallet              Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creatorId           String
  creator             CreatorProfile     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type                WalletTxType
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @default("CNY")
  status              WalletTxStatus     @default(PENDING)
  relatedSubmissionId String?
  relatedSubmission   Submission?        @relation(fields: [relatedSubmissionId], references: [id])
  relatedWithdrawalId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [relatedWithdrawalId], references: [id])
  isDemo              Boolean            @default(false)
  note                String?
  createdAt           DateTime           @default(now())
}

model WithdrawalRequest {
  id            String              @id @default(cuid())
  walletId      String
  wallet        Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("CNY")
  payoutMethod  String
  payoutDetails Json?
  status        WithdrawalStatus    @default(PENDING)
  adminNote     String?
  isDemo        Boolean             @default(false)
  transactions  WalletTransaction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Invoice {
  id               String       @id @default(cuid())
  brandId          String
  brand            BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  invoiceNumber    String?      @unique
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("CNY")
  status           String       @default("OPEN")
  dueDate          DateTime?
  paidAt           DateTime?
  paymentMethod    String?
  paymentProofUrl  String?
  paymentReference String?      @unique
  note             String?
  isDemo           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model BrandMessage {
  id             String        @id @default(cuid())
  brandId        String
  brand          BrandProfile  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestId      String?
  request        BrandRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorUserId   String?
  author         User?         @relation("BrandMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorRole     UserRole
  body           String
  visibleToBrand Boolean       @default(true)
  createdAt      DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  actorRole   UserRole?
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

model BrandLedgerTransaction {
  id               String              @id @default(cuid())
  brandId          String
  brand            BrandProfile        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type             BrandLedgerTxType
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("CNY")
  status           BrandLedgerTxStatus @default(PENDING)
  beforeBalance    Decimal?            @db.Decimal(12, 2)
  afterBalance     Decimal?            @db.Decimal(12, 2)
  relatedInvoiceId String?
  relatedRefundId  String?
  note             String?
  createdById      String?
  createdAt        DateTime            @default(now())
}

model BrandRefundRequest {
  id            String            @id @default(cuid())
  brandId       String
  brand         BrandProfile      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("CNY")
  status        BrandRefundStatus @default(PENDING)
  payoutMethod  String?
  payoutDetails Json?
  adminNote     String?
  isDemo        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ComplianceRule {
  id          String             @id @default(cuid())
  type        ComplianceRuleType
  keyword     String
  severity    RiskLevel          @default(MEDIUM)
  description String?
  active      Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RiskFlag {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  level      RiskLevel
  reason     String
  createdAt  DateTime  @default(now())
}

model Dispute {
  id                      String           @id @default(cuid())
  submissionId            String?
  submission              Submission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  campaignId              String?
  campaign                Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creatorId               String?
  brandId                 String?
  status                  DisputeStatus    @default(OPEN)
  reason                  String
  merchantReasonCategory  String?
  merchantNote            String?
  kolResponse             String?
  decision                DisputeDecision?
  partialSettlementAmount Decimal?         @db.Decimal(12, 2)
  resolution              String?
  decidedById             String?
  decidedAt               DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model PlatformSettings {
  id                                    String    @id @default("platform")
  acceptanceSlaDays                     Int       @default(3)
  highValueReviewThreshold              Decimal   @default(50) @db.Decimal(12, 2)
  resubmissionGraceDays                 Int       @default(2)
  minimumWithdrawalAmount               Decimal   @default(20) @db.Decimal(12, 2)
  kolPreviewMaxMb                       Int       @default(50)
  platformFeeRate                       Decimal   @default(0) @db.Decimal(6, 4)
  platformContactEmail                  String    @default("support@example.com")
  riskIndustryKeywords                  String[]  @default(["金融", "医疗", "医美", "保健", "投资", "教育", "减肥", "母婴"])
  riskIndustryPrompt                    String    @default("该行业容易涉及效果承诺、资质证明或监管要求。请确认 brief 不包含夸大承诺，并准备必要资质。")
  creatorTrendRefreshEnabled            Boolean   @default(true)
  creatorTrendRefreshHourUtc            Int       @default(19)
  creatorTrendRefreshDirections         String[]  @default(["beauty"])
  creatorTrendRefreshBatchCount         Int       @default(3)
  creatorTrendRefreshLastRunAt          DateTime?
  creatorTrendRefreshLastStatus         String?
  creatorTrendRefreshLastError          String?
  insightConfiguredCollectionBatchLimit Int       @default(10)
  insightZeroResultCooldownHours        Int       @default(2)
  insightCommentTargetCount             Int       @default(3)
  insightCommentPerContentLimit         Int       @default(8)
  insightDefaultHotKeywordPerRunLimit   Int       @default(12)
  insightDefaultStandardPerRunLimit     Int       @default(6)
  insightDefaultHotKeywordIntervalHours Int       @default(6)
  insightDefaultStandardIntervalHours   Int       @default(24)
  insightAiEnabled                      Boolean   @default(false)
  insightAiBaseUrl                      String?
  insightAiApiKey                       String?
  insightAiModel                        String    @default("chatgpt-4o-latest")
  insightAiSystemPrompt                 String    @default("你是中文短视频选题策划。基于真实帖子样本、互动数据和评论痛点，把候选选题改写成更具体、可创作、可执行的中文标题。返回严格 JSON：{\"items\":[{\"sampleSourceContentId\":\"string\",\"title\":\"string\",\"reason\":\"string\",\"angles\":[\"string\",\"string\",\"string\"]}]}。标题要求避免空泛词，优先写成问题型、避坑型、对比型或新手痛点型，不要直接照抄原帖标题。")
  updatedAt                             DateTime  @updatedAt
}

model CreatorTrendDailySnapshot {
  id                    String   @id @default(cuid())
  date                  DateTime
  direction             String
  overview              Json
  trendSeries           Json
  topicRows             Json
  recommendationBatches Json
  caseStudy             Json?
  source                String   @default("daily_refresh")
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, direction])
  @@index([direction, generatedAt])
}

model InsightTopic {
  id         String           @id @default(cuid())
  topic      String
  category   String?
  platforms  String[]         @default([])
  source     String
  sourceKey  String?
  heatValue  Float            @default(0)
  heatScore  Float            @default(0)
  growthRate Float?
  stage      String?
  date       DateTime
  rawPayload Json?
  contents   InsightContent[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([source, topic, date])
  @@index([topic, date])
  @@index([source, date])
  @@index([heatScore])
  @@index([date, heatScore])
  @@index([date, updatedAt])
}

model InsightContent {
  id              String           @id @default(cuid())
  platform        String
  sourceContentId String
  title           String
  description     String?
  authorId        String?
  authorName      String?
  publishTime     DateTime?
  contentUrl      String?
  likeCount       Int              @default(0)
  commentCount    Int              @default(0)
  shareCount      Int              @default(0)
  collectCount    Int              @default(0)
  viewCount       Int              @default(0)
  keyword         String?
  topicId         String?
  topic           InsightTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  heatScore       Float            @default(0)
  rawPayload      Json?
  comments        InsightComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([platform, sourceContentId])
  @@index([platform, keyword])
  @@index([keyword, createdAt])
  @@index([topicId])
  @@index([heatScore])
  @@index([publishTime])
  @@index([createdAt])
  @@index([platform, createdAt])
  @@index([createdAt, heatScore])
  @@index([createdAt, updatedAt])
}

model InsightComment {
  id              String         @id @default(cuid())
  platform        String
  sourceCommentId String?
  contentId       String
  content         InsightContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  text            String
  likeCount       Int            @default(0)
  sentiment       String?
  painPoint       String?
  riskTag         String?
  rawPayload      Json?
  createdAt       DateTime       @default(now())

  @@unique([platform, sourceCommentId, contentId])
  @@index([contentId])
  @@index([contentId, createdAt])
  @@index([contentId, likeCount])
  @@index([sentiment])
  @@index([painPoint])
  @@index([createdAt])
}

model InsightTrendSnapshot {
  id               String   @id @default(cuid())
  source           String   @default("tikhub")
  platform         String
  keyword          String
  keywordType      String?
  date             DateTime
  contentCount     Int      @default(0)
  interactionCount Int      @default(0)
  likeCount        Int      @default(0)
  commentCount     Int      @default(0)
  shareCount       Int      @default(0)
  collectCount     Int      @default(0)
  viewCount        Int      @default(0)
  heatScore        Float    @default(0)
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([source, platform, keyword, date])
  @@index([platform, keyword, date])
  @@index([keyword, date])
  @@index([platform, date, heatScore])
  @@index([date])
  @@index([heatScore])
}

model InsightKeywordConfig {
  id                   String    @id @default(cuid())
  keyword              String
  keywordType          String
  platform             String
  endpoint             String
  active               Boolean   @default(true)
  priority             Int       @default(100)
  perRunLimit          Int       @default(10)
  collectIntervalHours Int       @default(24)
  lastCollectedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([platform, keyword, keywordType])
  @@index([active, priority])
  @@index([platform, endpoint])
  @@index([lastCollectedAt])
}

model InsightCreator {
  id             String   @id @default(cuid())
  platform       String
  sourceAuthorId String
  authorName     String
  followerCount  Int      @default(0)
  category       String?
  contentTags    String[] @default([])
  avgEngagement  Float    @default(0)
  bestTopics     String[] @default([])
  rawPayload     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, sourceAuthorId])
  @@index([platform, category])
}

model InsightCollectionRun {
  id             String    @id @default(cuid())
  source         String
  platform       String?
  jobType        String
  status         String    @default("PENDING")
  keyword        String?
  requestPayload Json?
  resultCount    Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([status, startedAt])
  @@index([source, jobType])
}
