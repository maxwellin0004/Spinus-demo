model PaymentProviderConfig {
  id                   String   @id @default(cuid())
  provider             String
  enabled              Boolean  @default(false)
  visibleToBrand       Boolean  @default(true)
  environment          String   @default("sandbox")
  displayName          String   @default("Alipay")
  maintenanceMessage   String?
  sortOrder            Int      @default(100)
  appId                String?
  merchantId           String?
  certificateSerialNo  String?
  gatewayUrl           String?
  notifyUrl            String?
  returnUrl            String?
  encryptedPrivateKey  String?
  encryptedPublicKey   String?
  encryptedApiV3Key    String?
  privateKeyConfigured Boolean  @default(false)
  publicKeyConfigured  Boolean  @default(false)
  apiV3KeyConfigured   Boolean  @default(false)
  lastUpdatedById      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([provider])
  @@index([enabled, provider])
}

model PaymentProviderEvent {
  id           String    @id @default(cuid())
  provider     String
  eventType    String
  eventKey     String
  entityType   String?
  entityId     String?
  status       String    @default("PENDING")
  requestJson  Json?
  responseJson Json?
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, eventKey])
  @@index([provider, eventType, status])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CreatorTrendDailySnapshot {
  id                    String   @id @default(cuid())
  date                  DateTime
  direction             String
  overview              Json
  trendSeries           Json
  topicRows             Json
  recommendationBatches Json
  caseStudy             Json?
  source                String   @default("daily_refresh")
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date, direction])
  @@index([direction, generatedAt])
}

model CreatorTrendAiTopicDeck {
  id                   String    @id @default(cuid())
  cacheKey             String    @unique
  direction            String
  platform             String
  keyword              String    @default("")
  sampleSignature      String
  sampleContentIds     String[]  @default([])
  model                String
  promptHash           String
  batchCount           Int       @default(4)
  itemsPerBatch        Int       @default(3)
  items                Json
  status               String    @default("READY")
  errorMessage         String?
  refreshStatus        String    @default("IDLE")
  refreshFailureCount  Int       @default(0)
  refreshRetryAfter    DateTime?
  lastRefreshStartedAt DateTime?
  lastRefreshFailedAt  DateTime?
  lastRefreshError     String?
  generatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([direction, platform, keyword])
  @@index([sampleSignature])
  @@index([status, updatedAt])
  @@index([refreshStatus, refreshRetryAfter])
}

model CreatorSavedTrend {
  id                 String         @id @default(cuid())
  creatorId          String
  creator            CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title              String
  topic              String?
  platform           String?
  status             String         @default("SAVED")
  reason             String?
  sourceContentId    String?
  sourceUrl          String?
  plannedPublishDate DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([creatorId, title, platform])
  @@index([creatorId, status, createdAt])
  @@index([creatorId, updatedAt])
}

model CreatorTrendScriptGeneration {
  id                     String                     @id @default(cuid())
  creatorId              String
  creator                CreatorProfile             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  savedTrendId           String?
  sourceType             String
  sourceKey              String
  sourceTitle            String
  platform               String?
  status                 String                     @default("GENERATING")
  generationMode         String                     @default("FALLBACK")
  model                  String?
  userInstruction        String?
  sourcePayload          Json?
  graphicTablesJson      Json?
  videoTablesJson        Json?
  caseAnalysisTablesJson Json?
  plainText              String?
  errorMessage           String?
  aiDebugJson            Json?
  scriptImages           CreatorTrendScriptImage[]
  scriptReviews          CreatorTrendScriptReview[]
  generatedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([creatorId, sourceType, sourceKey])
  @@index([creatorId, updatedAt])
  @@index([sourceType, status, updatedAt])
  @@index([status, updatedAt])
}

model CreatorTrendScriptImage {
  id                 String                       @id @default(cuid())
  scriptGenerationId String
  scriptGeneration   CreatorTrendScriptGeneration @relation(fields: [scriptGenerationId], references: [id], onDelete: Cascade)
  pageKey            String
  pageLabel          String
  pageOrder          Int
  model              String
  promptHash         String
  prompt             String
  negativePrompt     String?
  aspectRatio        String?
  size               String
  imageUrl           String?
  status             String                       @default("READY")
  errorMessage       String?
  generatedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([scriptGenerationId, pageKey, promptHash, model])
  @@index([scriptGenerationId, pageOrder])
  @@index([status, updatedAt])
}

model CreatorTrendScriptReview {
  id                 String                       @id @default(cuid())
  scriptGenerationId String
  scriptGeneration   CreatorTrendScriptGeneration @relation(fields: [scriptGenerationId], references: [id], onDelete: Cascade)
  model              String
  inputHash          String
  status             String                       @default("READY")
  score              Int?
  summary            String?
  checksJson         Json?
  imageFindingsJson  Json?
  riskItemsJson      Json?
  suggestionsJson    Json?
  rawResponseJson    Json?
  errorMessage       String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([scriptGenerationId, inputHash, model])
  @@index([scriptGenerationId, updatedAt])
  @@index([status, updatedAt])
}

model CreatorTrendTopicImage {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  sourceContentId String?
  sourceTitle     String
  platform        String?
  model           String
  promptHash      String
  prompt          String
  negativePrompt  String?
  imageUrl        String?
  status          String   @default("READY")
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceContentId])
  @@index([status, updatedAt])
}

model InsightTopic {
  id         String           @id @default(cuid())
  topic      String
  category   String?
  platforms  String[]         @default([])
  source     String
  sourceKey  String?
  heatValue  Float            @default(0)
  heatScore  Float            @default(0)
  growthRate Float?
  stage      String?
  date       DateTime
  rawPayload Json?
  contents   InsightContent[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([source, topic, date])
  @@index([topic, date])
  @@index([source, date])
  @@index([heatScore])
  @@index([date, heatScore])
  @@index([date, updatedAt])
}

model InsightContent {
  id              String           @id @default(cuid())
  platform        String
  sourceContentId String
  title           String
  description     String?
  authorId        String?
  authorName      String?
  publishTime     DateTime?
  contentUrl      String?
  likeCount       Int              @default(0)
  commentCount    Int              @default(0)
  shareCount      Int              @default(0)
  collectCount    Int              @default(0)
  viewCount       Int              @default(0)
  keyword         String?
  topicId         String?
  topic           InsightTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  heatScore       Float            @default(0)
  rawPayload      Json?
  comments        InsightComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([platform, sourceContentId])
  @@index([platform, keyword])
  @@index([keyword, createdAt])
  @@index([topicId])
  @@index([heatScore])
  @@index([publishTime])
  @@index([createdAt])
  @@index([platform, createdAt])
  @@index([createdAt, heatScore])
  @@index([createdAt, updatedAt])
}

model InsightComment {
  id              String         @id @default(cuid())
  platform        String
  sourceCommentId String?
  contentId       String
  content         InsightContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  text            String
  likeCount       Int            @default(0)
  sentiment       String?
  painPoint       String?
  riskTag         String?
  rawPayload      Json?
  createdAt       DateTime       @default(now())

  @@unique([platform, sourceCommentId, contentId])
  @@index([contentId])
  @@index([contentId, createdAt])
  @@index([contentId, likeCount])
  @@index([sentiment])
  @@index([painPoint])
  @@index([createdAt])
}

model InsightTrendSnapshot {
  id               String   @id @default(cuid())
  source           String   @default("tikhub")
  platform         String
  keyword          String
  keywordType      String?
  date             DateTime
  contentCount     Int      @default(0)
  interactionCount Int      @default(0)
  likeCount        Int      @default(0)
  commentCount     Int      @default(0)
  shareCount       Int      @default(0)
  collectCount     Int      @default(0)
  viewCount        Int      @default(0)
  heatScore        Float    @default(0)
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([source, platform, keyword, date])
  @@index([platform, keyword, date])
  @@index([keyword, date])
  @@index([platform, date, heatScore])
  @@index([date])
  @@index([heatScore])
}

model InsightKeywordConfig {
  id                   String    @id @default(cuid())
  keyword              String
  keywordType          String
  platform             String
  endpoint             String
  active               Boolean   @default(true)
  priority             Int       @default(100)
  perRunLimit          Int       @default(10)
  collectIntervalHours Int       @default(24)
  lastCollectedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([platform, keyword, keywordType])
  @@index([active, priority])
  @@index([platform, endpoint])
  @@index([lastCollectedAt])
}

model InsightCreator {
  id             String   @id @default(cuid())
  platform       String
  sourceAuthorId String
  authorName     String
  followerCount  Int      @default(0)
  category       String?
  contentTags    String[] @default([])
  avgEngagement  Float    @default(0)
  bestTopics     String[] @default([])
  rawPayload     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, sourceAuthorId])
  @@index([platform, category])
}

model InsightCollectionRun {
  id             String    @id @default(cuid())
  source         String
  platform       String?
  jobType        String
  status         String    @default("PENDING")
  keyword        String?
  requestPayload Json?
  resultCount    Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([status, startedAt])
  @@index([source, jobType])
}
