generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  BRAND
  CREATOR
}

enum AdminLevel {
  FOUNDER
  STAFF
}

enum AdminDataScope {
  ALL
  ASSIGNED
  TEAM
}

enum UserStatus {
  ACTIVE
  PENDING
  FROZEN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CreatorLevel {
  NEW
  VERIFIED
  PRO
  ELITE
}

enum CreatorMembershipTier {
  NONE
  GROWTH
  PRO
}

enum CreatorMembershipApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_REVIEW
  REJECTED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

enum DraftStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  BLOCKED
}

enum DraftReviewStatus {
  NOT_REQUIRED
  NOT_SUBMITTED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  DRAFT_CREATED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  PROOF_SUBMITTED
  VERIFIED
  SETTLED
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_SUPPLEMENT
}

enum PublicationStatus {
  PENDING_PUBLICATION
  LINK_SUBMITTED
  ACCEPTED
  REJECTED
  RESUBMITTED
  DISPUTED
  EXPIRED
}

enum SettlementStatus {
  NOT_ESCROWED
  ESCROWED
  PAYABLE
  PAID_TO_WALLET
  REFUNDED
  PARTIALLY_SETTLED
  CANCELLED
}

enum WalletTxType {
  EARNING
  WITHDRAWAL
  ADJUSTMENT
  FREEZE
  UNFREEZE
}

enum BrandLedgerTxType {
  PAYMENT
  ESCROW_FREEZE
  ESCROW_RELEASE
  KOL_SETTLEMENT
  REFUND
  ADJUSTMENT
  PLATFORM_FEE
}

enum BrandLedgerTxStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum WalletTxStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BrandRefundStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum InvoiceStatus {
  REQUESTED
  OPEN
  PAYMENT_SUBMITTED
  PAID
  REJECTED
  VOID
}

enum ComplianceRuleType {
  SENSITIVE_WORD
  PROHIBITED_EXPRESSION
  DISCLOSURE
  PLATFORM_RULE
}

enum BrandRequestStatus {
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  CONVERTED
  CLOSED
}

enum SocialVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeStatus {
  OPEN
  NEEDS_INFO
  DECIDED
  CLOSED
}

enum DisputeDecision {
  FULL_SETTLEMENT
  FULL_REFUND
  PARTIAL_SETTLEMENT
  ALLOW_RESUBMISSION
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrawlerPlatform {
  XIAOHONGSHU
  DOUYIN
}

enum CrawlerJobType {
  FETCH_SOCIAL_ACCOUNT
  FETCH_POST_METRICS
  REFRESH_SOCIAL_ACCOUNT
  REFRESH_POST_METRICS
}

enum CrawlerTargetType {
  SOCIAL_ACCOUNT
  PROOF
}

enum CrawlerJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum CrawlerSnapshotStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AuthorMatchStatus {
  MATCHED
  MISMATCHED
  UNKNOWN
}

model User {
  id                             String                         @id @default(cuid())
  email                          String                         @unique
  passwordHash                   String
  role                           UserRole
  status                         UserStatus                     @default(ACTIVE)
  emailVerifiedAt                DateTime?
  passwordChangedAt              DateTime?
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  adminProfile                   AdminProfile?
  brandProfile                   BrandProfile?
  creatorProfile                 CreatorProfile?
  creatorReferral                CreatorReferralAttribution?
  reviewedMembershipApplications CreatorMembershipApplication[]
  invitationCodesCreated         InvitationCode[]               @relation("InvitationCodeCreator")
  invitationAttribution          InvitationAttribution?
  submissionReviews              SubmissionReview[]             @relation("Reviewer")
  brandMessages                  BrandMessage[]                 @relation("BrandMessageAuthor")
  supportTicketsOpened           SupportTicket[]                @relation("SupportTicketOpenedBy")
  supportTicketsAssigned         SupportTicket[]                @relation("SupportTicketAssignedTo")
  supportTicketNotes             SupportTicketNote[]
  notifications                  Notification[]
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AdminProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  level                  AdminLevel              @default(STAFF)
  permissions            String[]                @default([])
  dataScope              AdminDataScope          @default(ASSIGNED)
  teamName               String?
  wechat                 String?
  createdById            String?
  managedBrands          BrandProfile[]          @relation("BrandResponsible")
  managedCreators        CreatorProfile[]        @relation("CreatorResponsible")
  brandRequests          BrandRequest[]          @relation("BrandRequestResponsible")
  invitationCodes        InvitationCode[]
  invitationAttributions InvitationAttribution[] @relation("InvitationAttributionAdmin")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model InvitationCode {
  id             String                  @id @default(cuid())
  code           String                  @unique
  adminProfileId String
  adminProfile   AdminProfile            @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  active         Boolean                 @default(true)
  note           String?
  createdById    String?
  createdBy      User?                   @relation("InvitationCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attributions   InvitationAttribution[]
  deactivatedAt  DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([adminProfileId, active])
}

model InvitationAttribution {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationCodeId String
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  codeSnapshot     String
  invitedByAdminId String
  invitedByAdmin   AdminProfile   @relation("InvitationAttributionAdmin", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([invitedByAdminId, createdAt])
  @@index([codeSnapshot])
}

model BrandProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName           String
  companyName         String
  contactName         String
  email               String
  telegram            String?
  whatsapp            String?
  website             String?
  industry            String
  insightDirection    String                   @default("beauty")
  country             String
  logoUrl             String?
  description         String
  reviewStatus        ReviewStatus             @default(PENDING)
  riskLevel           RiskLevel                @default(LOW)
  internalNote        String?
  responsibleAdminId  String?
  responsibleAdmin    AdminProfile?            @relation("BrandResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  isDemo              Boolean                  @default(false)
  budgetBalance       Decimal                  @default(0) @db.Decimal(12, 2)
  frozenEscrowBalance Decimal                  @default(0) @db.Decimal(12, 2)
  campaigns           Campaign[]
  requests            BrandRequest[]
  messages            BrandMessage[]
  invoices            Invoice[]
  ledgerTransactions  BrandLedgerTransaction[]
  refundRequests      BrandRefundRequest[]
  supportTickets      SupportTicket[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model BrandRequest {
  id                  String             @id @default(cuid())
  brandId             String
  brand               BrandProfile       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  responsibleAdminId  String?
  responsibleAdmin    AdminProfile?      @relation("BrandRequestResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  title               String
  objective           String
  description         String
  budget              Decimal?           @db.Decimal(12, 2)
  expectedLaunchDate  DateTime?
  status              BrandRequestStatus @default(SUBMITTED)
  convertedCampaignId String?
  messages            BrandMessage[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model CreatorProfile {
  id                     String                         @id @default(cuid())
  userId                 String                         @unique
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  fullName               String?
  email                  String
  shareCode              String                         @unique
  country                String
  languages              String[]                       @default([])
  categories             String[]                       @default([])
  contentTypes           String[]                       @default([])
  insightDirection       String                         @default("beauty")
  bio                    String?
  avatarUrl              String?
  level                  CreatorLevel                   @default(NEW)
  membershipTier         CreatorMembershipTier          @default(NONE)
  membershipStartedAt    DateTime?
  membershipEndsAt       DateTime?
  membershipNote         String?
  reviewStatus           ReviewStatus                   @default(PENDING)
  riskLevel              RiskLevel                      @default(LOW)
  riskScore              Int                            @default(0)
  violationCount         Int                            @default(0)
  completionRate         Decimal                        @default(0) @db.Decimal(6, 2)
  cumulativeIncome       Decimal                        @default(0) @db.Decimal(12, 2)
  completedTasks         Int                            @default(0)
  responsibleAdminId     String?
  responsibleAdmin       AdminProfile?                  @relation("CreatorResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  isDemo                 Boolean                        @default(false)
  socialAccounts         SocialAccount[]
  applications           TaskApplication[]
  drafts                 ContentDraft[]
  submissions            Submission[]
  proofs                 Proof[]
  wallet                 Wallet?
  withdrawalRequests     WithdrawalRequest[]
  walletTransactions     WalletTransaction[]
  referralsReceived      CreatorReferralAttribution[]
  membershipApplications CreatorMembershipApplication[]
  savedTrends            CreatorSavedTrend[]
  trendScriptGenerations CreatorTrendScriptGeneration[]
  supportTickets         SupportTicket[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
}

model CreatorMembershipApplication {
  id               String                             @id @default(cuid())
  creatorId        String
  creator          CreatorProfile                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tier             CreatorMembershipTier
  amount           Decimal                            @db.Decimal(12, 2)
  currency         String                             @default("CNY")
  status           CreatorMembershipApplicationStatus @default(SUBMITTED)
  paymentReference String?
  paymentProofUrl  String?
  creatorNote      String?
  adminNote        String?
  reviewedById     String?
  reviewedBy       User?                              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  @@index([creatorId, createdAt])
  @@index([status, createdAt])
}

model CreatorReferralAttribution {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Restrict)
  codeSnapshot     String
  createdAt        DateTime       @default(now())

  @@index([creatorProfileId, createdAt])
  @@index([codeSnapshot])
}

model SocialAccount {
  id                   String                   @id @default(cuid())
  creatorId            String
  creator              CreatorProfile           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform             String
  accountName          String
  accountUrl           String
  followers            Int                      @default(0)
  avgViews             Int                      @default(0)
  submittedFollowers   Int                      @default(0)
  submittedAvgViews    Int                      @default(0)
  contentType          String
  country              String
  language             String
  verified             Boolean                  @default(false)
  verificationStatus   SocialVerificationStatus @default(PENDING)
  verificationNote     String?
  verifiedAt           DateTime?
  note                 String?
  selectedApplications TaskApplication[]
  crawlerJobs          CrawlerJob[]
  metricSnapshots      SocialAccountSnapshot[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model Campaign {
  id                            String                   @id @default(cuid())
  brandId                       String
  brand                         BrandProfile             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title                         String
  productName                   String?
  landingUrl                    String?
  industry                      String
  description                   String
  objective                     String
  targetPlatforms               String[]                 @default([])
  targetCountries               String[]                 @default([])
  targetLanguages               String[]                 @default([])
  targetAudience                String?
  startDate                     DateTime
  endDate                       DateTime
  totalBudget                   Decimal                  @db.Decimal(12, 2)
  creatorBudget                 Decimal                  @db.Decimal(12, 2)
  platformFee                   Decimal                  @db.Decimal(12, 2)
  currency                      String                   @default("CNY")
  escrowAmount                  Decimal                  @default(0) @db.Decimal(12, 2)
  escrowFrozenAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  escrowReleasedAmount          Decimal                  @default(0) @db.Decimal(12, 2)
  platformFeeRate               Decimal                  @default(0) @db.Decimal(6, 4)
  baseReward                    Decimal                  @db.Decimal(12, 2)
  bonusRules                    Json?
  brief                         String
  mustInclude                   String[]                 @default([])
  mustNotInclude                String[]                 @default([])
  visualRequirements            String[]                 @default([])
  hashtags                      String[]                 @default([])
  cta                           String
  disclosureRequired            Boolean                  @default(true)
  requiresDraftReview           Boolean                  @default(true)
  revisionLimit                 Int                      @default(2)
  acceptanceSlaDays             Int                      @default(3)
  highValueReviewThreshold      Decimal                  @default(50) @db.Decimal(12, 2)
  resubmissionGraceDays         Int                      @default(2)
  status                        CampaignStatus           @default(DRAFT)
  reviewNote                    String?
  slotsTotal                    Int                      @default(10)
  maxPerCreator                 Int                      @default(1)
  allowUnverifiedSocialAccounts Boolean                  @default(false)
  allowMultiPlatformProof       Boolean                  @default(false)
  riskLevel                     RiskLevel                @default(LOW)
  isDemo                        Boolean                  @default(false)
  assets                        CampaignAsset[]
  tasks                         CampaignTask[]
  drafts                        ContentDraft[]
  submissions                   Submission[]
  proofs                        Proof[]
  metricsSnapshots              MetricsSnapshot[]
  messages                      BrandMessage[]
  invoices                      Invoice[]
  ledgerTransactions            BrandLedgerTransaction[]
  refundRequests                BrandRefundRequest[]
  disputes                      Dispute[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
}

model CampaignAsset {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  url        String
  createdAt  DateTime @default(now())
}

model CampaignTask {
  id                   String            @id @default(cuid())
  campaignId           String
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title                String
  platform             String
  contentType          String
  platformRequirement  String?
  minimumFollowers     Int               @default(0)
  rewardAmount         Decimal           @db.Decimal(12, 2)
  slotsTotal           Int
  slotsTaken           Int               @default(0)
  creatorLevelRequired CreatorLevel      @default(NEW)
  deadline             DateTime
  draftDeadline        DateTime?
  publishDeadline      DateTime?
  status               TaskStatus        @default(ACTIVE)
  applications         TaskApplication[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model TaskApplication {
  id                          String            @id @default(cuid())
  taskId                      String
  task                        CampaignTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creatorId                   String
  creator                     CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status                      ApplicationStatus @default(APPLIED)
  applicationNote             String?
  selectedSocialAccountId     String?
  selectedSocialAccount       SocialAccount?    @relation(fields: [selectedSocialAccountId], references: [id], onDelete: SetNull)
  acceptedRequirementSnapshot Json?
  approvedAt                  DateTime?
  drafts                      ContentDraft[]
  submissions                 Submission[]
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@unique([taskId, creatorId])
}

model ContentDraft {
  id                   String            @id @default(cuid())
  applicationId        String
  application          TaskApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creatorId            String
  creator              CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId           String
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform             String
  title                String
  script               String
  caption              String
  hashtags             String[]          @default([])
  coverText            String
  disclosurePosition   String?
  previewAttachmentUrl String?
  revisionRound        Int               @default(0)
  revisionReason       String?
  aiGeneratedRaw       Json?
  creatorEditedText    String?
  riskCheckResult      Json?
  status               DraftStatus       @default(DRAFT)
  reviewStatus         DraftReviewStatus @default(NOT_SUBMITTED)
  submissions          Submission[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Submission {
  id                 String              @id @default(cuid())
  applicationId      String
  application        TaskApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  draftId            String
  draft              ContentDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status             SubmissionStatus    @default(SUBMITTED)
  publicationStatus  PublicationStatus   @default(PENDING_PUBLICATION)
  settlementStatus   SettlementStatus    @default(ESCROWED)
  settlementAmount   Decimal?            @db.Decimal(12, 2)
  acceptedAt         DateTime?
  disputedAt         DateTime?
  submittedAt        DateTime            @default(now())
  approvedAt         DateTime?
  rejectedAt         DateTime?
  revisionNote       String?
  reviews            SubmissionReview[]
  proofs             Proof[]
  walletTransactions WalletTransaction[]
  disputes           Dispute[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SubmissionReview {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User           @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerRole UserRole
  decision     ReviewDecision
  comment      String
  riskPoints   String[]       @default([])
  createdAt    DateTime       @default(now())
}

model Proof {
  id                  String               @id @default(cuid())
  submissionId        String
  submission          Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  creatorId           String
  creator             CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId          String
  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform            String
  postUrl             String
  resolvedPostUrl     String?
  normalizedPostUrl   String
  urlCheckResult      Json?
  screenshotUrl       String?
  publishedAt         DateTime
  views               Int                  @default(0)
  likes               Int                  @default(0)
  comments            Int                  @default(0)
  shares              Int                  @default(0)
  saves               Int                  @default(0)
  clicks              Int                  @default(0)
  conversions         Int                  @default(0)
  verificationStatus  ProofStatus          @default(PENDING)
  publicationStatus   PublicationStatus    @default(LINK_SUBMITTED)
  rejectionReason     String?
  rejectionNote       String?
  resubmissionCount   Int                  @default(0)
  adminNote           String?
  metricsSnapshots    MetricsSnapshot[]
  crawlerJobs         CrawlerJob[]
  postMetricSnapshots PostMetricSnapshot[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([platform, normalizedPostUrl])
}

model MetricsSnapshot {
  id          String   @id @default(cuid())
  proofId     String
  proof       Proof    @relation(fields: [proofId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  saves       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  snapshotAt  DateTime @default(now())
}

model CrawlerJob {
  id                String                  @id @default(cuid())
  type              CrawlerJobType
  platform          CrawlerPlatform
  status            CrawlerJobStatus        @default(PENDING)
  targetType        CrawlerTargetType
  targetId          String
  targetUrl         String
  socialAccountId   String?
  socialAccount     SocialAccount?          @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  proofId           String?
  proof             Proof?                  @relation(fields: [proofId], references: [id], onDelete: Cascade)
  attempts          Int                     @default(0)
  maxAttempts       Int                     @default(2)
  lockedAt          DateTime?
  lockedBy          String?
  lastAttemptAt     DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  lastErrorCategory String?
  createdByUserId   String?
  socialSnapshots   SocialAccountSnapshot[]
  postSnapshots     PostMetricSnapshot[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?

  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([targetType, targetId])
  @@index([socialAccountId])
  @@index([proofId])
}

model SocialAccountSnapshot {
  id              String                @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  crawlerJobId    String?
  crawlerJob      CrawlerJob?           @relation(fields: [crawlerJobId], references: [id], onDelete: SetNull)
  platform        CrawlerPlatform
  status          CrawlerSnapshotStatus @default(PENDING)
  failureReason   String?
  failureCategory String?
  dataConfidence  String                @default("UNKNOWN")
  displayName     String?
  profileUrl      String?
  platformUserId  String?
  followerCount   Int?
  followingCount  Int?
  likeCount       Int?
  postCount       Int?
  fetchedAt       DateTime
  rawProvider     String?
  rawUserId       String?
  rawCanonicalUrl String?
  rawMetricText   String?
  rawEvidence     Json?
  parserVersion   String?
  createdAt       DateTime              @default(now())

  @@index([socialAccountId, fetchedAt])
  @@index([crawlerJobId])
  @@index([platform, status])
  @@index([failureCategory])
}

model PostMetricSnapshot {
  id                   String                @id @default(cuid())
  proofId              String
  proof                Proof                 @relation(fields: [proofId], references: [id], onDelete: Cascade)
  crawlerJobId         String?
